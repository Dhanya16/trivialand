# PostgreSQL connection string
# Replace USER, PASSWORD, and database name with your local values.
# Special characters in the password must be URL-encoded (e.g. @ becomes %40).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/trivialand?schema=public"

# Port the NestJS API listens on (frontend runs on 3000)
PORT=3001

JWT_SECRET="your-secret-here-min-32-chars"
JWT_EXPIRES_IN="7d"