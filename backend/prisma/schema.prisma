// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LevelProgressStatus {
  locked
  unlocked
  completed
}

enum QuizAttemptType {
  normal
  ai
}

model User {
  id            String          @id @default(cuid())
  username      String          @unique
  email         String          @unique
  passwordHash  String          @map("password_hash")
  createdAt     DateTime        @default(now()) @map("created_at")
  levelProgress LevelProgress[]
  quizAttempts  QuizAttempt[]

  @@map("users")
}

model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String
  sortOrder     Int           @default(0) @map("sort_order")
  subcategories Subcategory[]

  @@index([sortOrder])
  @@map("categories")
}

model Subcategory {
  id         String   @id @default(cuid())
  slug       String
  name       String
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  levels     Level[]

  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Level {
  id            String          @id @default(cuid())
  name          String
  order         Int
  subcategoryId String          @map("subcategory_id")
  subcategory   Subcategory     @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  quizzes       Quiz[]
  levelProgress LevelProgress[]

  @@unique([subcategoryId, order])
  @@map("levels")
}

model Quiz {
  id        String        @id @default(cuid())
  title     String
  levelId   String        @map("level_id")
  level     Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id          String       @id @default(cuid())
  text        String
  explanation String?
  order       Int
  quizId      String       @map("quiz_id")
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options     Option[]
  quizAnswers QuizAnswer[]

  @@unique([quizId, order])
  @@map("questions")
}

model Option {
  id          String       @id @default(cuid())
  text        String
  isCorrect   Boolean      @default(false) @map("is_correct")
  questionId  String       @map("question_id")
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAnswers QuizAnswer[]

  @@map("options")
}

model LevelProgress {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  levelId   String              @map("level_id")
  status    LevelProgressStatus @default(locked)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Level               @relation(fields: [levelId], references: [id], onDelete: Cascade)
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([userId, levelId])
  @@map("level_progress")
}

model QuizAttempt {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  quizId      String          @map("quiz_id")
  score       Int
  total       Int
  type        QuizAttemptType @default(normal)
  completedAt DateTime        @default(now()) @map("completed_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([userId, completedAt])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id               String      @id @default(cuid())
  attemptId        String      @map("attempt_id")
  questionId       String      @map("question_id")
  selectedOptionId String      @map("selected_option_id")
  isCorrect        Boolean     @map("is_correct")
  attempt          QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   Option      @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("quiz_answers")
}
