// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LevelProgressStatus {
  locked
  unlocked
  completed
}

enum QuizAttemptType {
  normal
  ai
}

enum ContestStatus {
  upcoming
  live
  past
}

enum AiQuizStatus {
  processing
  ready
  failed
}

model User {
  id                    String                 @id @default(cuid())
  username              String                 @unique
  email                 String                 @unique
  passwordHash          String                 @map("password_hash")
  createdAt             DateTime               @default(now()) @map("created_at")
  levelProgress         LevelProgress[]
  quizAttempts          QuizAttempt[]
  contestParticipations ContestParticipation[]
  contestRating         ContestRating?
  discussions           Discussion[]           @relation("DiscussionAuthor")
  discussionReplies     DiscussionReply[]      @relation("ReplyAuthor")
  uploadedMaterials     UploadedMaterial[]
  aiQuizzes             AiQuiz[]
  aiQuizAttempts        AiQuizAttempt[]

  @@map("users")
}

model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String
  sortOrder     Int           @default(0) @map("sort_order")
  subcategories Subcategory[]

  @@index([sortOrder])
  @@map("categories")
}

model Subcategory {
  id         String   @id @default(cuid())
  slug       String
  name       String
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  levels     Level[]

  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Level {
  id            String          @id @default(cuid())
  name          String
  order         Int
  subcategoryId String          @map("subcategory_id")
  subcategory   Subcategory     @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  quizzes       Quiz[]
  levelProgress LevelProgress[]

  @@unique([subcategoryId, order])
  @@map("levels")
}

model Quiz {
  id          String        @id @default(cuid())
  title       String
  levelId     String        @map("level_id")
  level       Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  questions   Question[]
  attempts    QuizAttempt[]
  discussions Discussion[]

  @@map("quizzes")
}

model Question {
  id               String            @id @default(cuid())
  text             String
  explanation      String?
  order            Int
  quizId           String            @map("quiz_id")
  quiz             Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options          Option[]
  quizAnswers      QuizAnswer[]
  contestQuestions ContestQuestion[]
  contestAnswers   ContestAnswer[]
  discussions      Discussion[]

  @@unique([quizId, order])
  @@map("questions")
}

model Option {
  id             String          @id @default(cuid())
  text           String
  isCorrect      Boolean         @default(false) @map("is_correct")
  questionId     String          @map("question_id")
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAnswers    QuizAnswer[]
  contestAnswers ContestAnswer[]

  @@map("options")
}

model LevelProgress {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  levelId   String              @map("level_id")
  status    LevelProgressStatus @default(locked)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Level               @relation(fields: [levelId], references: [id], onDelete: Cascade)
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([userId, levelId])
  @@map("level_progress")
}

model QuizAttempt {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  quizId      String          @map("quiz_id")
  score       Int
  total       Int
  type        QuizAttemptType @default(normal)
  completedAt DateTime        @default(now()) @map("completed_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([userId, completedAt])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id               String      @id @default(cuid())
  attemptId        String      @map("attempt_id")
  questionId       String      @map("question_id")
  selectedOptionId String      @map("selected_option_id")
  isCorrect        Boolean     @map("is_correct")
  attempt          QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   Option      @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("quiz_answers")
}

model Contest {
  id              String                 @id @default(cuid())
  title           String
  description     String
  startTime       DateTime               @map("start_time")
  durationMinutes Int                    @map("duration_minutes")
  status          ContestStatus          @default(upcoming)
  questions       ContestQuestion[]
  participations  ContestParticipation[]

  @@index([status, startTime])
  @@map("contests")
}

model ContestQuestion {
  id         String   @id @default(cuid())
  contestId  String   @map("contest_id")
  questionId String   @map("question_id")
  points     Int      @default(1)
  order      Int
  contest    Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([contestId, questionId])
  @@unique([contestId, order])
  @@map("contest_questions")
}

model ContestParticipation {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  contestId   String          @map("contest_id")
  startedAt   DateTime        @default(now()) @map("started_at")
  submittedAt DateTime?       @map("submitted_at")
  score       Int?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest     Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  answers     ContestAnswer[]

  @@unique([userId, contestId])
  @@index([contestId, score])
  @@map("contest_participations")
}

model ContestAnswer {
  id               String               @id @default(cuid())
  participationId  String               @map("participation_id")
  questionId       String               @map("question_id")
  selectedOptionId String               @map("selected_option_id")
  isCorrect        Boolean              @map("is_correct")
  participation    ContestParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  question         Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   Option               @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([participationId, questionId])
  @@map("contest_answers")
}

model ContestRating {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  rating    Int      @default(1200)
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@map("contest_ratings")
}

model Discussion {
  id               String            @id @default(cuid())
  title            String
  topic            String
  authorId         String            @map("author_id")
  linkedQuestionId String?           @map("linked_question_id")
  linkedQuizId     String?           @map("linked_quiz_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  author           User              @relation("DiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  linkedQuestion   Question?         @relation(fields: [linkedQuestionId], references: [id], onDelete: SetNull)
  linkedQuiz       Quiz?             @relation(fields: [linkedQuizId], references: [id], onDelete: SetNull)
  replies          DiscussionReply[]

  @@index([createdAt])
  @@index([topic])
  @@map("discussions")
}

model DiscussionReply {
  id           String     @id @default(cuid())
  discussionId String     @map("discussion_id")
  authorId     String     @map("author_id")
  content      String
  createdAt    DateTime   @default(now()) @map("created_at")
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author       User       @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([discussionId, createdAt])
  @@map("discussion_replies")
}

model UploadedMaterial {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  filename    String
  mimeType    String   @map("mime_type")
  storagePath String   @map("storage_path")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiQuizzes   AiQuiz[]

  @@index([userId, createdAt])
  @@map("uploaded_materials")
}

model AiQuiz {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  materialId String           @map("material_id")
  title      String
  status     AiQuizStatus     @default(processing)
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   UploadedMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  questions  AiQuestion[]
  attempts   AiQuizAttempt[]

  @@index([userId, createdAt])
  @@map("ai_quizzes")
}

model AiQuestion {
  id          String     @id @default(cuid())
  aiQuizId    String     @map("ai_quiz_id")
  text        String
  explanation String?
  order       Int
  aiQuiz      AiQuiz     @relation(fields: [aiQuizId], references: [id], onDelete: Cascade)
  options     AiOption[]

  @@unique([aiQuizId, order])
  @@map("ai_questions")
}

model AiOption {
  id           String     @id @default(cuid())
  aiQuestionId String     @map("ai_question_id")
  text         String
  isCorrect    Boolean    @default(false) @map("is_correct")
  aiQuestion   AiQuestion @relation(fields: [aiQuestionId], references: [id], onDelete: Cascade)

  @@map("ai_options")
}

model AiQuizAttempt {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  aiQuizId    String   @map("ai_quiz_id")
  score       Int
  total       Int
  completedAt DateTime @default(now()) @map("completed_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiQuiz      AiQuiz   @relation(fields: [aiQuizId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("ai_quiz_attempts")
}
